      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "exclude_symlink_directories": null,
            "excludes": null,
            "id": "a43fdb4aea32ac27ad243a1dd413d533c3799df9",
            "output_base64sha256": "qhFAI9vkqnFaMFrhkdqrcfldtHehiz30CxCc1fFDWzk=",
            "output_base64sha512": "XA9OBkSkojk1NIYFEz0hQECkhjXN20ARzkH4JCsHHREMj+DR7E+WSfrIjCll5XLhdDgTQdqO3dKhWU3aamGN2w==",
            "output_file_mode": null,
            "output_md5": "c6607359dda16d2f50c1e9578dc40a86",
            "output_path": "./../dist/updateTurno.zip",
            "output_sha": "a43fdb4aea32ac27ad243a1dd413d533c3799df9",
            "output_sha256": "aa114023dbe4aa715a305ae191daab71f95db477a18b3df40b109cd5f1435b39",
            "output_sha512": "5c0f4e0644a4a23935348605133d214040a48635cddb4011ce41f8242b071d110c8fe0d1ec4f9649fac88c2965e572e174381341da8eddd2a1594dda6a618ddb",
            "output_size": 1619,
            "source": [
              {
                "content": "'use strict';\n\nconst { DynamoDBClient } = require('@aws-sdk/client-dynamodb');\nconst { DynamoDBDocumentClient } = require('@aws-sdk/lib-dynamodb');\n\n// Un solo cliente reutilizado entre invocaciones (fuera del handler) para\n// aprovechar el warm start de Lambda.\nconst client = new DynamoDBClient({});\nconst docClient = DynamoDBDocumentClient.from(client);\n\nconst TABLE_NAME = process.env.TABLE_NAME;\n\nfunction response(statusCode, body) {\n  return {\n    statusCode,\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(body),\n  };\n}\n\nmodule.exports = {\n  docClient,\n  TABLE_NAME,\n  response,\n};\n",
                "filename": "src/lib/dynamo.js"
              },
              {
                "content": "'use strict';\n\nconst { QueryCommand, UpdateCommand } = require('@aws-sdk/lib-dynamodb');\nconst { docClient, TABLE_NAME, response } = require('../lib/dynamo');\n\n/**\n * UPDATE — PUT /turnos/{turnoId}\n *\n * Mapeo CRUD -\u003e DynamoDB: Update -\u003e UpdateItem (parcial)\n *\n * A diferencia de SQL (\"UPDATE turnos SET estado=? WHERE id=?\"), en\n * DynamoDB no hay un UPDATE directo por un id \"suelto\": primero hay que\n * resolver PK+SK reales (vía GSI1, igual que en getTurno), y recién ahí\n * aplicar un UpdateItem que modifica solo los atributos indicados --\n * nunca se trae el item completo para pisarlo.\n */\nexports.handler = async (event) =\u003e {\n  const { turnoId } = event.pathParameters || {};\n  const body = JSON.parse(event.body || '{}');\n  const { estado, hora } = body;\n\n  if (!turnoId) {\n    return response(400, { message: 'Falta turnoId en el path' });\n  }\n\n  if (!estado \u0026\u0026 !hora) {\n    return response(400, {\n      message: 'Nada para actualizar: enviar estado y/o hora',\n    });\n  }\n\n  // 1) Resolver la clave primaria real (PK, SK) a partir del turnoId.\n  const found = await docClient.send(\n    new QueryCommand({\n      TableName: TABLE_NAME,\n      IndexName: 'GSI1',\n      KeyConditionExpression: 'GSI1PK = :turnoId',\n      ExpressionAttributeValues: { ':turnoId': turnoId },\n    })\n  );\n\n  if (!found.Items || found.Items.length === 0) {\n    return response(404, { message: 'Turno no encontrado' });\n  }\n\n  const { PK, SK } = found.Items[0];\n\n  // 2) UpdateItem parcial: solo toca los atributos enviados.\n  const updateParts = [];\n  const values = {};\n\n  if (estado) {\n    updateParts.push('estado = :estado');\n    values[':estado'] = estado;\n  }\n  if (hora) {\n    updateParts.push('hora = :hora');\n    values[':hora'] = hora;\n  }\n\n  const result = await docClient.send(\n    new UpdateCommand({\n      TableName: TABLE_NAME,\n      Key: { PK, SK },\n      UpdateExpression: `SET ${updateParts.join(', ')}`,\n      ExpressionAttributeValues: values,\n      ReturnValues: 'ALL_NEW',\n    })\n  );\n\n  return response(200, result.Attributes);\n};\n",
                "filename": "src/handlers/updateTurno.js"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
