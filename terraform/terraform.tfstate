            "id": "e1697260deb15ae99dd4fb7997f314d1a7629248",
            "output_base64sha256": "AE5k/9/j7vIAnht9OL86EokMSCh+ChoVRMj9p8yEFgM=",
            "output_base64sha512": "5rAY6QdbqrqqQzY+qp1l6bylWWRdZpMF7I3RYOXPkSN3qEU/X7bWJ2dJJsZaTzxjDgD/flEG2ZXR0iKJrrvvWw==",
            "output_file_mode": null,
            "output_md5": "6c4420b8cdab8cdf9a0c36676562c781",
            "output_path": "./../dist/createTurno.zip",
            "output_sha": "e1697260deb15ae99dd4fb7997f314d1a7629248",
            "output_sha256": "004e64ffdfe3eef2009e1b7d38bf3a12890c48287e0a1a1544c8fda7cc841603",
            "output_sha512": "e6b018e9075baabaaa43363eaa9d65e9bca559645d669305ec8dd160e5cf912377a8453f5fb6d627674926c65a4f3c630e00ff7e5106d995d1d22289aebbef5b",
            "output_size": 1466,
            "source": [
              {
                "content": "'use strict';\n\nconst { DynamoDBClient } = require('@aws-sdk/client-dynamodb');\nconst { DynamoDBDocumentClient } = require('@aws-sdk/lib-dynamodb');\n\n// Un solo cliente reutilizado entre invocaciones (fuera del handler) para\n// aprovechar el warm start de Lambda.\nconst client = new DynamoDBClient({});\nconst docClient = DynamoDBDocumentClient.from(client);\n\nconst TABLE_NAME = process.env.TABLE_NAME;\n\nfunction response(statusCode, body) {\n  return {\n    statusCode,\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(body),\n  };\n}\n\nmodule.exports = {\n  docClient,\n  TABLE_NAME,\n  response,\n};\n",
                "filename": "src/lib/dynamo.js"
              },
              {
                "content": "'use strict';\n\nconst { randomUUID } = require('crypto');\nconst { PutCommand } = require('@aws-sdk/lib-dynamodb');\nconst { docClient, TABLE_NAME, response } = require('../lib/dynamo');\n\n/**\n * CREATE — POST /turnos\n *\n * Mapeo CRUD -\u003e DynamoDB: Create -\u003e PutItem\n *\n * Diseño de claves:\n *   PK = VET#\u003cvetId\u003e\n *   SK = TURNO#\u003cfecha\u003e#\u003chora\u003e#\u003cturnoId\u003e\n *\n * El SK se construye para que un turno de una vet en una fecha quede\n * ordenado y sea \"query-able\" por prefijo (begins_with), sin necesitar\n * un JOIN ni un WHERE con scan de tabla completa.\n */\nexports.handler = async (event) =\u003e {\n  const body = JSON.parse(event.body || '{}');\n  const { vetId, fecha, hora, mascota, duenio } = body;\n\n  if (!vetId || !fecha || !hora || !mascota || !duenio) {\n    return response(400, {\n      message: 'Campos requeridos: vetId, fecha, hora, mascota, duenio',\n    });\n  }\n\n  const turnoId = randomUUID();\n\n  const item = {\n    PK: `VET#${vetId}`,\n    SK: `TURNO#${fecha}#${hora}#${turnoId}`,\n    GSI1PK: turnoId,\n    GSI1SK: turnoId,\n    turnoId,\n    vetId,\n    fecha,\n    hora,\n    mascota,\n    duenio,\n    estado: 'confirmado',\n    createdAt: new Date().toISOString(),\n  };\n\n  await docClient.send(\n    new PutCommand({\n      TableName: TABLE_NAME,\n      Item: item,\n      // Evita pisar un turno ya existente con la misma clave (misma vet,\n      // fecha, hora y id generado -- defensivo, el id es UUID).\n      ConditionExpression: 'attribute_not_exists(PK)',\n    })\n  );\n\n  return response(201, item);\n};\n",
                "filename": "src/handlers/createTurno.js"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
    {
      "mode": "data",
