            "id": "3b1bddceae0b94bcd8f4b75441f992ca4f21ed0c",
            "output_base64sha256": "npxVinJLenrKLHYuNha0+jki4Vc9rFKbAqHspZur8us=",
            "output_base64sha512": "U42FrLVM65oAvt2cXZAod88XZatI9Bdne7K0NPY0OrHJO1dMKs3S1g7zBDnBIuCSe6KJG4ReDBBOFrbEEuoYuQ==",
            "output_file_mode": null,
            "output_md5": "f85df88f4fb601a440832f4bfedfadca",
            "output_path": "./../dist/listTurnos.zip",
            "output_sha": "3b1bddceae0b94bcd8f4b75441f992ca4f21ed0c",
            "output_sha256": "9e9c558a724b7a7aca2c762e3616b4fa3922e1573dac529b02a1eca59babf2eb",
            "output_sha512": "538d85acb54ceb9a00bedd9c5d902877cf1765ab48f417677bb2b434f6343ab1c93b574c2acdd2d60ef30439c122e0927ba2891b845e0c104e16b6c412ea18b9",
            "output_size": 1382,
            "source": [
              {
                "content": "'use strict';\n\nconst { DynamoDBClient } = require('@aws-sdk/client-dynamodb');\nconst { DynamoDBDocumentClient } = require('@aws-sdk/lib-dynamodb');\n\n// Un solo cliente reutilizado entre invocaciones (fuera del handler) para\n// aprovechar el warm start de Lambda.\nconst client = new DynamoDBClient({});\nconst docClient = DynamoDBDocumentClient.from(client);\n\nconst TABLE_NAME = process.env.TABLE_NAME;\n\nfunction response(statusCode, body) {\n  return {\n    statusCode,\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(body),\n  };\n}\n\nmodule.exports = {\n  docClient,\n  TABLE_NAME,\n  response,\n};\n",
                "filename": "src/lib/dynamo.js"
              },
              {
                "content": "'use strict';\n\nconst { QueryCommand } = require('@aws-sdk/lib-dynamodb');\nconst { docClient, TABLE_NAME, response } = require('../lib/dynamo');\n\n/**\n * READ (listado) — GET /turnos?vetId=...\u0026fecha=...\n *\n * Mapeo CRUD -\u003e DynamoDB: Read por rango -\u003e Query con begins_with\n *\n * Este es el patrón de acceso principal del caso: \"todos los turnos de\n * una veterinaria en un día\". No existe un SELECT * ni un WHERE libre:\n * el acceso se resuelve porque el SK se diseñó como\n * TURNO#\u003cfecha\u003e#\u003chora\u003e#\u003cturnoId\u003e, lo que permite filtrar por prefijo\n * (begins_with) de forma eficiente, sin tocar registros de otros días\n * ni de otras veterinarias.\n */\nexports.handler = async (event) =\u003e {\n  const { vetId, fecha } = event.queryStringParameters || {};\n\n  if (!vetId) {\n    return response(400, { message: 'Falta query param vetId' });\n  }\n\n  const skPrefix = fecha ? `TURNO#${fecha}` : 'TURNO#';\n\n  const result = await docClient.send(\n    new QueryCommand({\n      TableName: TABLE_NAME,\n      KeyConditionExpression: 'PK = :pk AND begins_with(SK, :skPrefix)',\n      ExpressionAttributeValues: {\n        ':pk': `VET#${vetId}`,\n        ':skPrefix': skPrefix,\n      },\n    })\n  );\n\n  return response(200, { turnos: result.Items || [] });\n};\n",
                "filename": "src/handlers/listTurnos.js"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
    {
      "mode": "data",
