            "output_path": "./../dist/deleteTurno.zip",
            "output_sha": "0ec237cb5a6afc65afc64326809fe871a9a2ad76",
            "output_sha256": "209a5c813b8e9eb279dcf9830965dd14ff8c2b74768d4eca0b89deeefa28c3c6",
            "output_sha512": "a88040339f53fe1ac5c24e1876dfe3c2c7d0178869e42b57fce50b36ad74e64c38f7fde6961305dd4ff2529b6ff52c194f2d350ea8f76f8c99ea49c545788d8c",
            "output_size": 1233,
            "source": [
              {
                "content": "'use strict';\n\nconst { DynamoDBClient } = require('@aws-sdk/client-dynamodb');\nconst { DynamoDBDocumentClient } = require('@aws-sdk/lib-dynamodb');\n\n// Un solo cliente reutilizado entre invocaciones (fuera del handler) para\n// aprovechar el warm start de Lambda.\nconst client = new DynamoDBClient({});\nconst docClient = DynamoDBDocumentClient.from(client);\n\nconst TABLE_NAME = process.env.TABLE_NAME;\n\nfunction response(statusCode, body) {\n  return {\n    statusCode,\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(body),\n  };\n}\n\nmodule.exports = {\n  docClient,\n  TABLE_NAME,\n  response,\n};\n",
                "filename": "src/lib/dynamo.js"
              },
              {
                "content": "'use strict';\n\nconst { QueryCommand, DeleteCommand } = require('@aws-sdk/lib-dynamodb');\nconst { docClient, TABLE_NAME, response } = require('../lib/dynamo');\n\n/**\n * DELETE — DELETE /turnos/{turnoId}\n *\n * Mapeo CRUD -\u003e DynamoDB: Delete -\u003e DeleteItem\n *\n * Mismo patrón que update: resolver PK+SK vía GSI1 antes de poder borrar,\n * porque DeleteItem en DynamoDB requiere la clave primaria completa.\n */\nexports.handler = async (event) =\u003e {\n  const { turnoId } = event.pathParameters || {};\n\n  if (!turnoId) {\n    return response(400, { message: 'Falta turnoId en el path' });\n  }\n\n  const found = await docClient.send(\n    new QueryCommand({\n      TableName: TABLE_NAME,\n      IndexName: 'GSI1',\n      KeyConditionExpression: 'GSI1PK = :turnoId',\n      ExpressionAttributeValues: { ':turnoId': turnoId },\n    })\n  );\n\n  if (!found.Items || found.Items.length === 0) {\n    return response(404, { message: 'Turno no encontrado' });\n  }\n\n  const { PK, SK } = found.Items[0];\n\n  await docClient.send(\n    new DeleteCommand({\n      TableName: TABLE_NAME,\n      Key: { PK, SK },\n    })\n  );\n\n  return response(204, null);\n};\n",
                "filename": "src/handlers/deleteTurno.js"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
